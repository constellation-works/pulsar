{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "published"
  ],
  "properties": {
    "published": {
      "type": "boolean",
      "description": "False for a dry run: nothing was sent."
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account",
          "provider",
          "digest",
          "estimated_cost_usd",
          "posts"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "estimated_cost_usd": {
            "type": "number"
          },
          "posts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "description": "A dry run: what would be sent, per account."
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ok",
          "account",
          "digest",
          "state",
          "items",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "account": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "replayed": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "idx",
                "state"
              ],
              "properties": {
                "idx": {
                  "type": "integer"
                },
                "state": {
                  "type": "string"
                },
                "post_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "properties": {
                  "ok": {
                    "const": false
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "detail": {}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "Per account: the receipt, or why it was refused."
    }
  },
  "additionalProperties": false
}
