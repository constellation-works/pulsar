{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "default_account",
    "healthy",
    "ready",
    "attention",
    "accounts"
  ],
  "properties": {
    "default_account": {
      "type": [
        "string",
        "null"
      ],
      "description": "Effective default: configured default_account, else the sole non-revoked bound account; null when none or several are bound without a configured default."
    },
    "healthy": {
      "type": "boolean",
      "description": "Every account is healthy (not merely unverified) with nothing unresolved."
    },
    "ready": {
      "type": "boolean",
      "description": "Offline gate for the explicit account, else the effective default. False when no account is selected, its health is unhealthy, it has unresolved writes, or legacy credentials await migration. Unverified health, including an expired access token with a stored refresh token, may be settled by the first live call. Does not prove refresh will succeed or bypass approval, budget, caps or quiet hours."
    },
    "attention": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alias",
          "status",
          "authorized",
          "reauth_required",
          "health",
          "reason",
          "healthy",
          "unresolved",
          "last_published"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "expected_handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorized": {
            "type": "boolean"
          },
          "reauth_required": {
            "type": "boolean"
          },
          "token_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_token_expires_in_s": {
            "type": [
              "integer",
              "null"
            ]
          },
          "health": {
            "enum": [
              "healthy",
              "unverified",
              "unhealthy"
            ],
            "description": "unverified: nothing is known to be wrong, but local state cannot settle it (no cached identity, or an expired token whose refresh was not exercised); `pulsar auth status --live` settles it."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the account is not healthy; null when it is."
          },
          "healthy": {
            "type": "boolean"
          },
          "posts": {
            "type": [
              "object",
              "null"
            ]
          },
          "day": {
            "type": [
              "object",
              "null"
            ]
          },
          "month": {
            "type": [
              "object",
              "null"
            ]
          },
          "quiet": {
            "type": [
              "object",
              "null"
            ]
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_published": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
